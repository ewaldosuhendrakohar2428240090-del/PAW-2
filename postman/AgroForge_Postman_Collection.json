          }
        },
        {
          "name": "POST Buat Komplain Baru",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": \"Budi Santoso\",\n  \"issue\": \"Pengiriman traktor terlambat dari jadwal\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/complaints", "host": ["{{baseUrl}}"], "path": ["admin", "complaints"] }
          }
        },
        {
          "name": "PUT Tandai Selesai Komplain",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/complaints/C-001/resolve", "host": ["{{baseUrl}}"], "path": ["admin", "complaints", "C-001", "resolve"] }
          }
        },
        {
          "name": "GET Daftar Penjual (Sellers)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/sellers", "host": ["{{baseUrl}}"], "path": ["admin", "sellers"] }
          }
        }
      ]
    }
  ]
}
