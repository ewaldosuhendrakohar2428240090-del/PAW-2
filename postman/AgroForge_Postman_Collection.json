            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
          }
        },
        {
          "name": "POST Buat Pesanan Baru (Checkout)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalAmount\": 87500,\n  \"paymentMethod\": \"Transfer Bank\",\n  \"items\": [\n    {\n      \"product\": {\n        \"id\": \"P001\",\n        \"productTitle\": \"Traktor Utilitas John Deere 6120M\",\n        \"itemPrice\": 87500,\n        \"imageUrl\": \"https://images.unsplash.com/photo-1592982537447-7440770cbfc9?w=700&h=480&fit=crop&auto=format\"\n      },\n      \"quantity\": 1\n    }\n  ],\n  \"shippingAddress\": {\n    \"fullName\": \"Marcus Tillman\",\n    \"addressLine1\": \"Jl. Jendral Sudirman No. 100\",\n    \"city\": \"Palembang\",\n    \"state\": \"Sumatera Selatan\",\n    \"zipCode\": \"30129\",\n    \"phone\": \"081298765432\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
          }
        }
      ]
    },
    {
      "name": "04. Admin",
      "item": [
        {
          "name": "GET Admin Stats & Monitoring",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/stats", "host": ["{{baseUrl}}"], "path": ["admin", "stats"] }
          }
