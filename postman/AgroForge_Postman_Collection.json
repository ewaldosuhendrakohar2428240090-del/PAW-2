{
  "info": {
    "_postman_id": "agroforge-restful-api-collection-2026",
    "name": "AgroForge RESTful API",
    "description": "Koleksi Postman untuk pengujian RESTful API AgroForge Marketplace Agrikultur. Dikembangkan dengan Express.js dan MongoDB.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Auth",
      "item": [
        {
          "name": "Login (Pembeli)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.environment.set(\"token\", res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"marcus@tillmanfarm.com\",\n  \"password\": \"farm2024\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Penjual / Seller)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"seller@agroforge.com\",\n  \"password\": \"seller2024\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@agroforge.com\",\n  \"password\": \"admin2024\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Register User Baru",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ewaldo Suhendra Kohar\",\n  \"email\": \"ewaldo@agroforge.com\",\n  \"password\": \"password123\",\n  \"role\": \"penjual\",\n  \"farmName\": \"Ewaldo Agro Farm\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Get Profile Me (Verify Token)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "02. Products",
      "item": [
        {
          "name": "GET Semua Produk",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "GET Filter Produk Kategori & Search",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?category=Traktor & Mesin&search=John Deere",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "category", "value": "Traktor & Mesin" },
                { "key": "search", "value": "John Deere" }
              ]
            }
          }
        },
        {
          "name": "GET Detail Produk By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products/P001", "host": ["{{baseUrl}}"], "path": ["products", "P001"] }
          }
        },
        {
          "name": "POST Tambah Produk (Seller / Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"AGRO-TRAK-2026\",\n  \"productTitle\": \"Traktor Mini Diesel 25HP\",\n  \"productDescription\": \"Traktor efisien bahan bakar cocok untuk lahan terasering.\",\n  \"itemPrice\": 32000,\n  \"category\": \"Traktor & Mesin\",\n  \"brand\": \"Kubota\",\n  \"stockStatus\": \"in_stock\",\n  \"stockQuantity\": 4,\n  \"imageUrl\": \"https://images.unsplash.com/photo-1592982537447-7440770cbfc9?w=700&h=480&fit=crop&auto=format\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "DELETE Produk By ID",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/products/AGRO-TRAK-2026", "host": ["{{baseUrl}}"], "path": ["products", "AGRO-TRAK-2026"] }
          }
        }
      ]
    },
    {
